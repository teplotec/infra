#!/usr/bin/env bash
set -Eeuo pipefail

RUNNER_USER="github-runner"
SOURCE_SCRIPT="${1:-./scripts/erp-admin}"
TARGET_SCRIPT="/usr/local/sbin/teplotec-erp-admin"
SUDOERS_FILE="/etc/sudoers.d/teplotec-erp-admin"

if [[ $EUID -ne 0 ]]; then
  echo "Run this installer as root" >&2
  exit 1
fi

if [[ ! -f "$SOURCE_SCRIPT" ]]; then
  echo "Admin script not found: $SOURCE_SCRIPT" >&2
  exit 1
fi

if ! id "$RUNNER_USER" >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash "$RUNNER_USER"
fi

install -o root -g root -m 0750 "$SOURCE_SCRIPT" "$TARGET_SCRIPT"

cat > "$SUDOERS_FILE" <<EOF
$RUNNER_USER ALL=(root) NOPASSWD: $TARGET_SCRIPT *
EOF

chmod 0440 "$SUDOERS_FILE"
visudo -cf "$SUDOERS_FILE"

echo "Installed $TARGET_SCRIPT"
echo "Prepared user $RUNNER_USER for the GitHub self-hosted runner"
