#!/usr/bin/env bash
set -Eeuo pipefail

ERP_HOSTNAME="erp.teplotec.com"
ROOT_DIR="/opt/teplotec/erpnext"
FRAPPE_DIR="$ROOT_DIR/frappe_docker"
GITOPS_DIR="$ROOT_DIR/gitops"
ENV_FILE="$GITOPS_DIR/erpnext.env"
COMPOSE_FILE="$GITOPS_DIR/docker-compose.yml"
PROJECT_NAME="teplotec-erp"
TEPLOTEC_IMAGE="ghcr.io/teplotec/erpnext"
REQUIRED_APPS=(crm teplotec_erp)

compose() {
  docker compose \
    --project-name "$PROJECT_NAME" \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" \
    "$@"
}

require_runtime() {
  test -f "$ENV_FILE" || { echo "Missing $ENV_FILE" >&2; exit 1; }
  test -f "$COMPOSE_FILE" || { echo "Missing $COMPOSE_FILE" >&2; exit 1; }
  test -d "$FRAPPE_DIR" || { echo "Missing $FRAPPE_DIR" >&2; exit 1; }
  command -v docker >/dev/null 2>&1 || { echo "docker is not installed" >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "python3 is not installed" >&2; exit 1; }
}

read_admin_password() {
  IFS= read -r admin_password
  if [[ -z "$admin_password" ]]; then
    echo "Administrator password was not provided on stdin" >&2
    exit 1
  fi
}

mariadb_root_password() {
  awk -F= '/^DB_PASSWORD=/{print substr($0, index($0, "=") + 1)}' "$ENV_FILE"
}

set_env_value() {
  local key="$1"
  local value="$2"

  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]
lines = path.read_text(encoding="utf-8").splitlines()
new_line = f"{key}={value}"

for index, line in enumerate(lines):
    if line.startswith(f"{key}="):
        lines[index] = new_line
        break
else:
    lines.append(new_line)

path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
}

regenerate_compose() {
  local temporary_file
  temporary_file="$(mktemp "$GITOPS_DIR/docker-compose.yml.XXXXXX")"

  cd "$FRAPPE_DIR"
  docker compose --env-file "$ENV_FILE" \
    -f compose.yaml \
    -f overrides/compose.mariadb.yaml \
    -f overrides/compose.redis.yaml \
    -f overrides/compose.noproxy.yaml \
    config > "$temporary_file"

  chmod 600 "$temporary_file"
  mv "$temporary_file" "$COMPOSE_FILE"
}

render_setup_args() {
  local setup_file="$1"

  python3 - "$setup_file" <<'PY'
import calendar
import json
import sys
from datetime import datetime
from zoneinfo import ZoneInfo

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    config = json.load(handle)

start_month = int(config.pop("financial_year_start_month", 1))
timezone = config.get("timezone", "UTC")
now = datetime.now(ZoneInfo(timezone))
start_year = now.year if now.month >= start_month else now.year - 1
end_year = start_year + 1 if start_month != 1 else start_year
end_month = 12 if start_month == 1 else start_month - 1
end_day = calendar.monthrange(end_year, end_month)[1]

config["fy_start_date"] = f"{start_year:04d}-{start_month:02d}-01"
config["fy_end_date"] = f"{end_year:04d}-{end_month:02d}-{end_day:02d}"

print(json.dumps(config, separators=(",", ":"), ensure_ascii=False))
PY
}

ensure_required_apps_installed() {
  local app
  for app in "${REQUIRED_APPS[@]}"; do
    if compose exec -T backend bash -lc \
        "bench --site '$ERP_HOSTNAME' list-apps | grep -q '^$app'"; then
      continue
    fi

    echo "Installing $app on $ERP_HOSTNAME..."
    compose exec -T backend bench --site "$ERP_HOSTNAME" install-app "$app"
  done
}

verify_required_apps_in_image() {
  local app
  for app in "${REQUIRED_APPS[@]}"; do
    if ! compose exec -T backend bash -lc "grep -qx '$app' sites/apps.txt"; then
      echo "$app is missing from the deployed image" >&2
      exit 1
    fi
  done
}

require_runtime

case "${1:-}" in
  status)
    compose ps
    ;;

  restart)
    compose restart
    ;;

  migrate)
    compose exec -T backend bench --site "$ERP_HOSTNAME" migrate
    ;;

  set-admin-password)
    read_admin_password
    compose exec -T backend \
      bench --site "$ERP_HOSTNAME" set-admin-password "$admin_password"
    unset admin_password
    ;;

  pilot)
    ensure_required_apps_installed
    echo "Creating or resuming the disposable TEPLOTEC ERPNext downstream pilot..."
    compose exec -T backend \
      bench --site "$ERP_HOSTNAME" execute teplotec_erp.pilot.create_pilot_scenario
    echo "Verifying the TEPLOTEC ERPNext downstream pilot..."
    compose exec -T backend \
      bench --site "$ERP_HOSTNAME" execute teplotec_erp.pilot.verify_pilot_scenario
    echo "TEPLOTEC ERPNext downstream pilot created and verified."
    ;;

  deploy-image)
    image_ref="${2:-}"
    if [[ ! "$image_ref" =~ ^ghcr\.io/teplotec/erpnext:sha-[0-9a-f]{40}$ ]]; then
      echo "Usage: $0 deploy-image ghcr.io/teplotec/erpnext:sha-<40-char-git-sha>" >&2
      exit 64
    fi

    IFS= read -r registry_user
    IFS= read -r registry_token
    if [[ -z "$registry_user" || -z "$registry_token" ]]; then
      echo "GHCR username and token must be provided on stdin" >&2
      exit 1
    fi

    printf '%s' "$registry_token" | docker login ghcr.io -u "$registry_user" --password-stdin >/dev/null
    trap 'docker logout ghcr.io >/dev/null 2>&1 || true' EXIT

    image_name="${image_ref%:*}"
    image_tag="${image_ref##*:}"

    if [[ "$image_name" != "$TEPLOTEC_IMAGE" ]]; then
      echo "Unexpected image repository: $image_name" >&2
      exit 1
    fi

    set_env_value CUSTOM_IMAGE "$image_name"
    set_env_value CUSTOM_TAG "$image_tag"
    set_env_value PULL_POLICY always
    regenerate_compose

    echo "Pulling immutable ERP image $image_ref..."
    compose pull
    compose up -d --remove-orphans

    verify_required_apps_in_image
    ensure_required_apps_installed
    compose exec -T backend bench --site "$ERP_HOSTNAME" migrate
    compose exec -T backend bench --site "$ERP_HOSTNAME" clear-cache

    unset registry_user registry_token
    echo "Deployed $image_ref and synchronized Frappe CRM plus TEPLOTEC ERP."
    ;;

  reset)
    setup_file="${2:-}"
    if [[ -z "$setup_file" || ! -r "$setup_file" ]]; then
      echo "Usage: $0 reset /path/to/erp-setup.json" >&2
      exit 64
    fi

    read_admin_password
    db_password="$(mariadb_root_password)"
    if [[ -z "$db_password" ]]; then
      echo "DB_PASSWORD is missing from $ENV_FILE" >&2
      exit 1
    fi

    setup_args="$(render_setup_args "$setup_file")"

    echo "Reinstalling $ERP_HOSTNAME with the current installed apps..."
    compose exec -T backend \
      bench --site "$ERP_HOSTNAME" reinstall \
      --yes \
      --mariadb-root-password "$db_password" \
      --admin-password "$admin_password"

    echo "Applying version-controlled ERP setup profile..."
    compose exec -T backend \
      bench --site "$ERP_HOSTNAME" execute \
      frappe.desk.page.setup_wizard.setup_wizard.setup_complete \
      --args "[$setup_args]"

    ensure_required_apps_installed
    compose exec -T backend bench --site "$ERP_HOSTNAME" clear-cache
    compose exec -T backend bench --site "$ERP_HOSTNAME" migrate

    unset admin_password db_password setup_args
    echo "ERP reset and setup completed."
    ;;

  *)
    echo "Usage: $0 {status|restart|migrate|set-admin-password|pilot|deploy-image|reset}" >&2
    exit 64
    ;;
esac
